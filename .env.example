# Copy to .env and fill in. NEVER commit .env.

ENVIRONMENT=development
DEBUG=false

# PostgreSQL. Create a dedicated role — do not run the app as the superuser.
#   CREATE ROLE mj_admin LOGIN PASSWORD 'choose-a-strong-one';
#   CREATE DATABASE mj_portfolio OWNER mj_admin;
DATABASE_URL=postgresql+psycopg://mj_admin:CHANGE_ME@localhost:5432/mj_portfolio

# Signing key for short-lived pending-2FA tokens. At least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_ONE

# Browser origins allowed to call the API with credentials. Comma separated.
# A wildcard is not permitted for credentialed requests.
CORS_ORIGINS=http://localhost:3000,http://localhost:5174

SESSION_LIFETIME_HOURS=12
MAX_FAILED_LOGINS=5

# --- production only ---------------------------------------------------------
# The API refuses to start with ENVIRONMENT=production unless the next three are
# set correctly. That is deliberate: each one is silent at boot and only visible
# from a browser console, or from an audit months later.

# This service's own hostname(s), comma separated. Enforced as a Host header
# allow-list. Leave empty in development, where the host is whatever you typed.
#   Live service: majeed-portfolio-backend.onrender.com
#   Keep that entry alongside the custom API domain once DNS is set, so the
#   service keeps answering through the cutover:
#     ALLOWED_HOSTS=majeed-portfolio-backend.onrender.com,api.your-domain.example
ALLOWED_HOSTS=

# How many trusted proxies sit in front of the app.
#   0 — direct exposure (local development). X-Forwarded-For is ignored.
#   1 — behind one appending proxy: Render, Vercel, Cloudflare.
#
# Every per-IP limit depends on this. At 0 behind a proxy, all requests appear to
# come from the proxy and every visitor shares one rate-limit bucket. Set above
# the real number and a client can spoof its own address in the header.
TRUSTED_PROXY_COUNT=0

# Where uploaded media is written. Empty means backend/storage, which is
# right for local development.
#
# MUST be a persistent volume in production. Render's filesystem resets on every
# deploy and restart, so uploads written to the default path disappear and the
# media library fills with rows whose files no longer exist.
#   Render with a disk mounted at /var/data:  STORAGE_ROOT=/var/data/storage
STORAGE_ROOT=

# `SameSite` for the session and CSRF cookies.
#   lax  — the default and the one to aim for. Works when the admin and the API
#          share a registrable domain (example.com calling api.example.com is
#          cross-origin but same-SITE, so the cookie is still sent).
#   none — required only across different registrable domains, e.g. an admin on
#          *.vercel.app calling an API on *.onrender.com. A real weakening: the
#          browser stops enforcing same-site entirely, leaving the double-submit
#          CSRF token as the only defence, and browsers increasingly block such
#          cookies anyway. Requires ENVIRONMENT=production for Secure.
SESSION_COOKIE_SAMESITE=lax

# Cookie Domain for the CSRF cookie. LEAVE EMPTY unless you need it.
#
# Empty means host-only, which is correct whenever the admin and the API are
# the SAME ORIGIN — the Vite dev proxy, and the nginx deployment that proxies
# /api/ on one host.
#
# Set it when they are different hosts of one registrable domain, e.g. the
# admin on example.com calling an API on api.example.com. CSRF here is
# double-submit: the admin must READ the cookie to echo it in a header, and a
# host-only cookie set by api.example.com is invisible to document.cookie on
# example.com. The session cookie still rides along, so the session is valid
# and only the CSRF check fails — a 403 "CSRF check failed" on every save.
#
# Use the registrable domain with NO leading dot. Only the CSRF cookie uses
# it; the HttpOnly session cookie stays host-only on purpose.
#
# A value the browser rejects — a public suffix such as onrender.com, or a
# domain that does not cover the API host — makes the browser drop the cookie
# entirely, which is worse than the bug it fixes.
#   production example: COOKIE_DOMAIN=mohammedmajeedportfolio.me
COOKIE_DOMAIN=

# The static host's build hook, fired after a successful publish or rollback.
# Optional — with no hook set, publishing still records the snapshot and the
# admin says plainly that the site was not rebuilt.
#
# TREAT THIS AS A SECRET. A build hook URL is a bearer credential: anyone who
# has it can trigger unlimited builds. The API never returns it.
#   Netlify:  https://api.netlify.com/build_hooks/<id>
#   Vercel:   https://api.vercel.com/v1/integrations/deploy/<id>/<hash>
DEPLOY_HOOK_URL=
DEPLOY_HOOK_TIMEOUT_SECONDS=10
